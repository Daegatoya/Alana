{
  "name": "Alana",
  "scopeName": "source.alana",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#visibility" },
    { "include": "#declarations" },
    { "include": "#natives" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#self" },
    { "include": "#members" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.alana",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.alana",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.alana",
          "match": "\\\\\""
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.alana",
      "begin": "'",
      "end": "'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.alana",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.alana",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "visibility": {
      "patterns": [
        {
          "name": "storage.modifier.alana",
          "match": "^\\s*(public|private)\\s*:"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(define)\\s+(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "storage.type.function.alana" },
            "3": { "name": "entity.name.function.alana" }
          }
        },
        {
          "match": "\\b(define)\\s+(abstract)?\\s*(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "storage.modifier.alana" },
            "3": { "name": "storage.type.class.alana" },
            "4": { "name": "entity.name.type.class.alana" },
            "5": { "name": "storage.modifier.alana" },
            "6": { "name": "entity.name.type.class.alana" }
          }
        },
        {
          "match": "\\b(define)\\s+(override|abstract)\\s+(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "storage.modifier.alana" },
            "3": { "name": "storage.type.function.alana" },
            "4": { "name": "entity.name.function.alana" }
          }
        },
        {
          "match": "\\b(define)\\s+(constructor)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "storage.type.constructor.alana" }
          }
        },
        {
          "match": "\\b(define)\\s+(num|str|decimal|schar|boolean|any)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "support.type.primitive.alana" }
          }
        },
        {
          "match": "\\b(define)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(is)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "entity.name.type.class.alana" },
            "3": { "name": "variable.other.alana" },
            "4": { "name": "keyword.operator.assignment.alana" }
          }
        },
        {
          "match": "\\b(newobj)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.alana" },
            "2": { "name": "entity.name.type.class.alana" }
          }
        },
        {
          "match": "\\b(call)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control.alana" },
            "2": { "name": "entity.name.function.alana" }
          }
        },
        {
          "match": "\\b(returning)\\s+(num|str|decimal|schar|boolean|any)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "support.type.primitive.alana" }
          }
        },
        {
          "match": "\\b(returning)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.alana" },
            "2": { "name": "entity.name.type.class.alana" }
          }
        },
        {
          "match": "\\b(import|including)\\s+",
          "name": "keyword.control.import.alana"
        }
      ]
    },
    "natives": {
      "patterns": [
        {
          "name": "support.function.native.alana",
          "match": "\\b__(http_request|http_status|http_body|http_header|http_dispose|json_serialize|error_message|error_line|error_col|error_source)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.alana",
          "match": "\\b(num|str|decimal|schar|boolean|any)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.alana",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.alana",
          "match": "\\b(times|divide|mod)\\b"
        },
        {
          "name": "keyword.operator.comparison.alana",
          "match": "\\b(sameas|greaterthan|lessthan|grorsame|leorsame|isa)\\b"
        },
        {
          "name": "keyword.operator.logical.alana",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.assignment.alana",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.operator.arithmetic.alana",
          "match": "[+\\-]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.alana",
          "match": "\\b(showln|show|readln|readk|length|parsenum|parsestr|parseboolean|parseschar|parsedecimal|tryparsenum|tryparsedecimal|tryparseboolean|tryparseschar|push|pop)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.alana",
          "match": "\\b(if|elseif|else|while|for|forevery|break|continue|return|end|call|try|catch|throw|finally)\\b"
        },
        {
          "name": "storage.modifier.alana",
          "match": "\\b(public|private)\\b"
        },
        {
          "name": "keyword.declaration.alana",
          "match": "\\b(define|redefine|func|class|constructor|returning|newobj|new|extends|override|abstract)\\b"
        },
        {
          "name": "keyword.other.alana",
          "match": "\\b(with|within|import|including)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.alana",
          "match": "\\b(self|parent)\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "entity.name.function.method.alana",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.alana",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}
