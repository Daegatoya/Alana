{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(define\\s+(func|class|constructor)\\b|if\\b|while\\b|for\\s*\\(|forevery\\s*\\(|try\\s*;|catch\\s*\\(|finally\\s*;)",
      "end": "^\\s*end\\s*;"
    }
  },
  "wordPattern": "(-?\\d[\\d.]*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(define\\s+(func|class|constructor)\\b.*|if\\b.*|elseif\\b.*|else\\s*;\\s*|while\\b.*|for\\s*\\(.*|forevery\\s*\\(.*|try\\s*;|catch\\s*\\(.*|finally\\s*;|public:\\s*|private:\\s*)(;\\s*)?(//.*)?$",
    "decreaseIndentPattern": "^\\s*(end\\s*;|else\\s*;|elseif\\b|catch\\b|finally\\b)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(define\\s+(func|class|constructor)\\b.*|if\\b.*|elseif\\b.*|else\\s*;\\s*|while\\b.*|for\\s*\\(.*|forevery\\s*\\(.*|try\\s*;|catch\\s*\\(.*|finally\\s*;)\\s*$",
      "afterText": "^\\s*end\\s*;",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*(define\\s+(func|class|constructor)\\b.*|if\\b.*|elseif\\b.*|else\\s*;\\s*|while\\b.*|for\\s*\\(.*|forevery\\s*\\(.*|try\\s*;|catch\\s*\\(.*|finally\\s*;|public:\\s*|private:\\s*)\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
