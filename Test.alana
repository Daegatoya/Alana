define num x is 25#
define num global is 100#
define boolean flag is true#

show x#

if x sameas 25#
    define num y is 25#
    show y#

    if y sameas x#
        redefine y is 40#
        redefine x is 50#
        show y#
        show x#
    end#

    show y#
    show x#
end#

show x#
show global#

define func test(num a)#
    show a#

    redefine global is 200#

    define num local is 10#
    show local#

    if a greaterthan 5#
        redefine local is 99#
        redefine global is 300#

        define num inner is 123#
        show inner#
        show local#
        show global#
    end#

    show local#
    show global#
end#

call test(10)#

show global#

define num z is new#
redefine z is 777#
show z#